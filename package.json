{
  "name": "nuitral-suite",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "playgrounds/*",
    "doc"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "dev:doc": "turbo run dev --filter=nuitral-doc",
    "build:doc": "turbo run build --filter=nuitral-doc"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
